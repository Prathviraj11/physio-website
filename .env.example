# Copy this file to `.env.local` and fill in YOUR values.
# NEVER commit .env.local — it is in .gitignore.

# --- Supabase (used by the /api testimonial functions) ---
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-sb_secret-key

# --- Contact form (Formspree) ---
# Create a form at formspree.io, set the recipient email in its project
# settings, then paste the endpoint here: https://api.formspree.io/f/<your-form-id>
FORMSPREE_ENDPOINT=https://api.formspree.io/f/YOUR_FORM_ID
